# Copy this file to .env.local and fill in real values before deploying.
# Never commit .env.local — it's already excluded via .gitignore.

# Email notifications for the contact form (app/api/contact/route.ts).
# Uses your own Gmail account via Nodemailer — completely free, no third-party service.
#
# Setup:
# 1. Enable 2-Step Verification on the Gmail account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
#    (Select "Mail" as the app, generate, and copy the 16-character password)
# 3. Paste that password below (NOT your regular Gmail password)
GMAIL_USER=truecareonline24@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_NOTIFICATION_EMAIL=truecareonline24@gmail.com

# Powers the "Find a Doctor" report-analysis chat (app/api/find-doctor/route.ts).
# Uses Google's Gemini API, which has a genuinely free, ongoing tier (no card required).
# Get a key at https://aistudio.google.com/app/apikey — keep this server-side only, never expose it to the browser.
GEMINI_API_KEY=

# Powers large medical-report file uploads on the knee replacement landing page
# (app/api/report-upload/route.ts, app/bd/knee-replacement-india/ReportForm.tsx).
# Uses Vercel Blob so files upload directly from the browser, bypassing the
# 4.5MB request body limit that applies to all Vercel Serverless Functions.
#
# Setup (one-time, in the Vercel dashboard, NOT locally):
# 1. Open your project on vercel.com → Storage tab → Create Database → Blob
# 2. Connect it to this project — Vercel automatically adds BLOB_READ_WRITE_TOKEN
#    to your project's Environment Variables. You do NOT need to copy/paste it.
# 3. To test file uploads locally, run `vercel env pull .env.local` after linking
#    this project with `vercel link`, which pulls the token down for local dev.
BLOB_READ_WRITE_TOKEN=

# Sends an automated WhatsApp confirmation to the PATIENT after they submit
# the report form (app/api/report-submission/route.ts, lib/whatsapp.ts).
# Requires your own Meta WhatsApp Business Cloud API account — this is a
# separate, real setup process (Meta Business Manager account, phone number
# verification, and an approved message template). See the detailed
# walkthrough and cost notes in the comment at the top of lib/whatsapp.ts
# before setting these. If left blank, this feature simply does nothing —
# the WhatsApp click-to-chat button and email notifications still work fine.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# Error monitoring — surfaces silent production failures (failed emails,
# failed uploads, etc.) as real alerts instead of buried logs.
# Setup: create a free account at https://sentry.io → create a Next.js
# project → copy its DSN below. Leave blank to disable entirely (safe).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed if you want source maps uploaded during build for readable
# stack traces (optional, requires an Auth Token from Sentry → Settings →
# Account → API Keys). Leave blank to skip source map upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional extra spam-protection layer (see lib/turnstile.ts for full setup).
# Leave both blank to rely on the always-on honeypot + timing check instead.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Structured lead logging to a Google Sheet, as a backup beyond your inbox
# (see lib/googleSheets.ts for full setup steps).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
